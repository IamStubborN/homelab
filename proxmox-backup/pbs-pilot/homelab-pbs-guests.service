[Unit]
Description=PBS guest recovery points (pilot)
After=network-online.target pve-guests.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homelab-pbs-guests
ExecStopPost=-/usr/local/libexec/homelab-backup-monitor record weekly-guests
Nice=10
AllowedCPUs=0-2
CPUQuota=150%
IOWeight=50
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
SuccessExitStatus=75
