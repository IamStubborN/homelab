+                    if (job != null)
+                        Volatile.Write(ref job.WaitingForDependency, true);
+                    NoteJobActivity(job);
+                    JacRedLog.Warning(JacRedLogCategories.Trackers,
+                        $"{trackerName}: browser dependency unavailable; waiting before retrying the same page");
+                    try
+                    {
+                        await Task.Delay(retryDelay ?? TimeSpan.FromSeconds(60), cancellationToken).ConfigureAwait(false);
+                    }
+                    finally
+                    {
+                        if (job != null)
+                            Volatile.Write(ref job.WaitingForDependency, false);
+                    }
+                }
+            }
+        }
