#!/usr/bin/env python3
"""Print a deterministic revision for the checked-in media MCP tool schema."""

from __future__ import annotations

import hashlib
import json
import pathlib
import sys


def schema_revision(path: pathlib.Path) -> str:
    payload = json.loads(path.read_text(encoding="utf-8"))
    tools = payload.get("tools")
    if payload.get("schema_version") != 1 or not isinstance(tools, list) or not tools:
        raise ValueError("invalid media MCP schema artifact")
    if any(not isinstance(tool, dict) or not isinstance(tool.get("name"), str) for tool in tools):
        raise ValueError("invalid media MCP tool schema")
    canonical = json.dumps(
        sorted(tools, key=lambda tool: tool["name"]),
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    )
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def main() -> int:
    if len(sys.argv) != 2:
        return 2
    try:
        revision = schema_revision(pathlib.Path(sys.argv[1]))
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"media MCP schema error: {error}", file=sys.stderr)
        return 1
    print(revision)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
