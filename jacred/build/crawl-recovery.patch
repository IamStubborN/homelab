new file mode 100644
index 0000000..1f32e76
--- /dev/null
+++ b/Infrastructure/Networking/CrawlSolverAdmission.cs
@@ -0,0 +1,42 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace JacRed.Infrastructure.Networking
+{
+    /// <summary>
+    /// Serializes crawl requests across tracker hosts and backs off a failing dependency.
+    /// Solver-side serialization is still required: a disconnected HTTP client cannot
+    /// establish that its remote browser has finished.
+    /// </summary>
+    internal sealed class CrawlSolverAdmission
+    {
+        readonly SemaphoreSlim gate = new(1, 1);
+        readonly Func<DateTime> utcNow;
+        readonly TimeSpan backoff;
+        DateTime retryAfter;
+
+        internal CrawlSolverAdmission(Func<DateTime> utcNow = null, TimeSpan? backoff = null)
+        {
+            this.utcNow = utcNow ?? (() => DateTime.UtcNow);
+            this.backoff = backoff ?? TimeSpan.FromSeconds(60);
+        }
+
+        internal async Task<T> RunAsync<T>(Func<Task<T>> operation)
+        {
+            await gate.WaitAsync();
+            try
+            {
+                if (utcNow() < retryAfter)
+                    throw new SolverDependencyUnavailableException("Crawl browser dependency is backing off; retry this page later.");
+                try { return await operation(); }
+                catch (SolverDependencyUnavailableException)
+                {
+                    retryAfter = utcNow() + backoff;
+                    throw;
+                }
+            }
+            finally { gate.Release(); }
+        }
+    }
+}
