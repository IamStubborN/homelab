[Unit]
Description=Nightly Lampac runtime update from upstream latest
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/home/iamstubborn/homelab/lampa/auto-update.sh
# The script starts a build by 04:55 and an apply by 05:25; a failed apply and
# its rollback end by about 05:50. This only stops a hung build or rollback, before the nightly
# build-cache prune (06:05). Next night reports the unfinished phase.
TimeoutStartSec=75min
