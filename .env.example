# Root homelab environment template. Copy to .env and fill real values locally.
# Keep this file secret-free: placeholders only.

# =============================================================================
# Active stack variables
# =============================================================================

# Public-safe host and path defaults. Override these in the real local `.env`.
DOCKER_DOMAIN=host-5.example.invalid.example
HOMELAB_ROOT=/opt/homelab
INTERNAL_STORAGE=/mnt/internal
# Family wiki vault on the Docker host, outside the Git checkout.
WIKI_ROOT=/mnt/internal/wiki
USB_STORAGE=/mnt/usb_drive
PLEX_ORPHAN_WATCHER_IMAGE=ghcr.io/iamstubborn/plex-orphan-watcher:0.4.4@sha256:b7e418b81c62301447aae609a9017f59c511594bbf5c3dac6e70a6c6b02c8f2a
TIMEZONE=UTC
# Mosquitto publishes its ports on this address; the Home Assistant upstream in
# traefik/config/config.example.yml uses the same address.
LAN_BIND_IP=127.0.0.1
# Uptime Kuma's Traefik allowlist and Gluetun's FIREWALL_OUTBOUND_SUBNETS.
LAN_SUBNET=192.0.2.0/24
# Glance reads LAN_DOMAIN and WEATHER_LOCATION from glance/.env, not from here.

# Vaultwarden DOMAIN: the public Send/link URL behind the Cloudflare Tunnel.
BITWARDEN_PUBLIC_URL=https://bitwarden.example.test

# Traefik / Cloudflare
CF_API_EMAIL=you@example.com

# Plex
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx

# Media orchestrator (included by root compose.yml, project homelab)
# Pin application images to a release tag plus digest. Postgres is a major
# tag without a digest so Watchtower can apply 17.x patches.
# Copy a private export to this ignored directory before running Hermes preflight.
MEDIA_RELEASE_DIR=/path/to/homelab/media/release
MEDIA_POSTGRES_IMAGE=postgres:17-alpine
MEDIA_SERVICE_IMAGE=ghcr.io/your-org/media-orchestrator:0.1.0@sha256:replace-with-real-digest
DOWNLOAD_RUNNER_IMAGE=ghcr.io/your-org/media-orchestrator:0.1.0@sha256:replace-with-real-digest
# Locally built health/mcp image; compose falls back to family-health-mcp:local.
HEALTH_MCP_IMAGE=family-health-mcp:local
GLUETUN_REZKA_IMAGE=qmcgaw/gluetun:v3.41.1@sha256:replace-with-real-digest
GLUETUN_REZKA_WATCHER_IMAGE=docker:28.3.2-cli@sha256:replace-with-real-digest
MEDIA_SECRETS_DIR=/opt/homelab/media/orchestrator-secrets
PUID=1000
PGID=1000
# The guarded media deploy derives this from /var/run/docker.sock and persists it here.
DOCKER_SOCKET_GID=replace-with-host-docker-socket-gid
MEDIA_POSTGRES_DB=media_orchestrator
MEDIA_POSTGRES_USER=media
MEDIA_NETWORK=media-internal
PRIMARY_TELEGRAM_USER_ID=replace-with-telegram-user-id
PRIMARY_TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
SECONDARY_TELEGRAM_USER_ID=replace-with-telegram-user-id
SECONDARY_TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
MEDIA_PLEX_TV_SECTION=replace-with-tv-section-id
MEDIA_PLEX_MOVIES_SECTION=replace-with-movies-section-id
MEDIA_QBITTORRENT_TV_CATEGORY=tv
MEDIA_QBITTORRENT_MOVIES_CATEGORY=movies
MEDIA_QBITTORRENT_USERNAME=replace-with-username
GLUETUN_REZKA_SERVER_COUNTRIES=Bulgaria
# Docker subnets gluetun-rezka may reach outside VPN (currently: proxy)
GLUETUN_REZKA_OUTBOUND_SUBNETS=192.0.2.12/16
MEDIA_REZKA_MIRRORS=https://rezka.example
MEDIA_REZKA_SESSION_PROBE_URL=https://rezka.example/account/probe
MEDIA_REZKA_SESSION_VALID_MARKERS_JSON=["account-menu"]
MEDIA_REZKA_SESSION_INVALID_MARKERS_JSON=["login-form"]
MEDIA_RUST_LOG=info
RENDER_GID=109
VIDEO_GID=44

# Hermes (hermes/compose.yaml). Commented values are the Compose defaults;
# override them only for private paths or existing volumes.
# HERMES_PRIMARY_PROFILE_DIR=./profiles/primary
# HERMES_SECONDARY_PROFILE_DIR=./profiles/secondary
# HERMES_PRIMARY_WIKI_PATH=/mnt/internal/wiki/primary
# HERMES_SECONDARY_WIKI_PATH=/mnt/internal/wiki/secondary
# HERMES_VAULTWARDEN_SERVER_PATH=./config/vaultwarden-server.example
# HERMES_VAULTWARDEN_ALLOWLIST_PATH=./config/vaultwarden-login-allowlist.example.json
# true reuses existing named volumes (HERMES_*_VOLUME, default homelab_hermes_*).
# HERMES_EXISTING_VOLUMES=false
# HERMES_PRIMARY_PROFILE_VOLUME=homelab_hermes_primary_profile
# HERMES_SECONDARY_PROFILE_VOLUME=homelab_hermes_secondary_profile
# Secret file paths, relative to hermes/. Each profile has *_TELEGRAM_TOKEN_PATH,
# *_MEDIA_API_TOKEN_PATH, *_HOMEASSISTANT_TOKEN_PATH, *_GROQ_API_KEY_PATH,
# *_WEBHOOK_HMAC_PATH and *_HEALTH_API_TOKEN_PATH, for example:
# HERMES_PRIMARY_TELEGRAM_TOKEN_PATH=./secrets/primary.telegram_token
# Must name the same file as HEALTH_PRIMARY_TOKEN_PATH (and likewise for
# secondary), or MCP authentication fails.
# HERMES_PRIMARY_HEALTH_API_TOKEN_PATH=../health/secrets/primary.health_api_token
# HERMES_SECONDARY_HEALTH_API_TOKEN_PATH=../health/secrets/secondary.health_api_token

# Karakeep
KARAKEEP_VERSION=release
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=https://karakeep.${DOCKER_DOMAIN}
MEILI_MASTER_KEY=change-me-at-least-16-bytes
KARAKEEP_CRAWLER_ALLOWED_INTERNAL_HOSTNAMES=freedium.${DOCKER_DOMAIN}

# Freedium
ADMIN_SECRET_KEY=change-me
FREEDIUM_POSTGRES_PASSWORD=change-me
FREEDIUM_DATABASE_URL=postgresql://postgres:change-me@freedium-db:5432/postgres

# Movie Tracker
MT_LOG_LEVEL=INFO
MT_TG_BOT_API_KEY=change-me
MT_TG_BOT_CHAT_IDS=123456789
MT_QBITTORRENT_USERNAME=
MT_QBITTORRENT_PASSWORD=
MT_PROWLARR_URL=http://prowlarr:9696
MT_PROWLARR_API_KEY=change-me
MT_TMDB_API_KEY=change-me
MT_TMDB_LANGUAGE=ru
MT_DATABASE_URL=sqlite:///./app.db

# --- Docker secrets (do not put real values in .env) ---
# media: files under MEDIA_SECRETS_DIR (see media/compose.media-orchestrator.yml secrets:)
# LLM: hermes/secrets/{opencode_go_api_key,tavily_api_key,exa_api_key,nvidia_api_key}
# LLM gateway: hermes/secrets/cliproxy_api_key (+ cliproxyapi/config.yaml api-keys)
# hermes groq: hermes/secrets/{primary,secondary}.groq_api_key

# CLIProxyAPI (OpenAI-compatible gateway). Client key is NOT an env var —
# put the same value in cliproxyapi/config.yaml api-keys and hermes/secrets/cliproxy_api_key.
# Public: https://cliproxy.${DOCKER_DOMAIN}/v1  |  Internal: http://cli-proxy-api:8317/v1  |  HA: http://127.0.0.1:8317/v1

# Uptime Kuma: enable only after initial administrator setup on loopback.
UPTIME_KUMA_INGRESS_ENABLED=false
# Optional observer readiness-path sources; empty retains the normal LAN allowlist.
UPTIME_KUMA_OBSERVER_SOURCES=
