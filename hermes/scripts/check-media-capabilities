#!/usr/bin/env python3
"""Check Hermes media capabilities against an exported release bundle."""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import sys
import tempfile

from media_release_contract import ContractError, load_release_contract


ROOT = pathlib.Path(__file__).resolve().parents[1]
CAPABILITY_DOC = ROOT / "shared/skills/media/CAPABILITIES.md"
SCHEMA_ARTIFACT = ROOT / "shared/skills/media/MCP_SCHEMA.json"
PROFILES = (
    ROOT / "profiles/andrii/config/config.yaml",
    ROOT / "profiles/valentyna/config/config.yaml",
)


def expected_document(tool_names: list[str]) -> str:
    return "\n".join(
        [
            "# Media MCP Capabilities",
            "",
            "This file is generated from the validated Media Orchestrator release bundle.",
            "",
            "Hermes discovers every published tool dynamically. This catalog is",
            "documentation, not an allowlist or an authorization policy.",
            "",
            *[f"- `{name}`" for name in tool_names],
            "",
        ]
    )


def referenced_tools() -> set[str]:
    references: set[str] = set()
    for path in ROOT.glob("shared/skills/*/SKILL.md"):
        source = path.read_text(encoding="utf-8")
        references.update(re.findall(r"`((?:media|plex|qbittorrent)_[a-z0-9_]+)`", source))
    for path in ROOT.glob("shared/plugins/**/*.py"):
        source = path.read_text(encoding="utf-8")
        references.update(re.findall(r"mcp__media_admin__([a-z][a-z0-9_]*)", source))
    references.discard("plex_delete")
    return references


def _stage_text(path: pathlib.Path, value: str) -> pathlib.Path:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = pathlib.Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(value)
            output.flush()
            os.fsync(output.fileno())
        temporary.chmod(path.stat().st_mode & 0o777 if path.exists() else 0o644)
        return temporary
    except BaseException:
        temporary.unlink(missing_ok=True)
        raise


def _restore(path: pathlib.Path, original: tuple[bytes, int] | None) -> None:
    if original is None:
        path.unlink(missing_ok=True)
        return
    content, mode = original
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.rollback.", dir=path.parent)
    temporary = pathlib.Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        temporary.chmod(mode)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def atomic_write_texts(updates: tuple[tuple[pathlib.Path, str], ...]) -> None:
    originals = {
        path: (path.read_bytes(), path.stat().st_mode & 0o777) if path.exists() else None
        for path, _ in updates
    }
    staged: dict[pathlib.Path, pathlib.Path] = {}
    published: list[pathlib.Path] = []
    try:
        for path, value in updates:
            staged[path] = _stage_text(path, value)
        for path, _ in updates:
            os.replace(staged.pop(path), path)
            published.append(path)
    except OSError as publication_error:
        for path in reversed(published):
            _restore(path, originals[path])
        raise publication_error
    finally:
        for temporary in staged.values():
            temporary.unlink(missing_ok=True)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--release-dir", type=pathlib.Path)
    parser.add_argument("--sync", action="store_true", help="copy validated bundle artifacts")
    args = parser.parse_args()
    configured = args.release_dir or os.environ.get("MEDIA_RELEASE_DIR")
    if not configured:
        print("MEDIA_RELEASE_DIR is required", file=sys.stderr)
        return 1
    release_dir = pathlib.Path(configured).resolve()

    try:
        load_release_contract(release_dir)
        schema_text = (release_dir / "MCP_SCHEMA.json").read_text(encoding="utf-8")
        schema = json.loads(schema_text)
        capabilities = json.loads(
            (release_dir / "media-capabilities.json").read_text(encoding="utf-8")
        )
    except (ContractError, OSError, UnicodeError, json.JSONDecodeError) as error:
        print(f"media release contract error: {error}", file=sys.stderr)
        return 1

    names = capabilities["tools"]
    errors: list[str] = []
    for profile in PROFILES:
        source = profile.read_text(encoding="utf-8")
        if "media_admin:" not in source:
            errors.append(f"{profile}: media_admin MCP server is missing")
        if re.search(r"^\s+(?:include|exclude):", source, flags=re.MULTILINE):
            errors.append(f"{profile}: media MCP tools must be discovered without include/exclude")
    references = referenced_tools()
    unknown = sorted(references - set(names))
    if unknown:
        errors.append(f"Hermes references tools absent from the release bundle: {', '.join(unknown)}")
    undocumented = sorted(set(names) - references)
    if undocumented:
        errors.append(f"Release tools absent from Hermes skills/plugins: {', '.join(undocumented)}")
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1

    expected = expected_document(names)
    if args.sync:
        try:
            atomic_write_texts(((SCHEMA_ARTIFACT, schema_text), (CAPABILITY_DOC, expected)))
        except OSError as error:
            print(f"media capability sync failed: {error}", file=sys.stderr)
            return 1
    errors = []
    if not CAPABILITY_DOC.exists() or CAPABILITY_DOC.read_text(encoding="utf-8") != expected:
        errors.append("shared/skills/media/CAPABILITIES.md is stale; run with --sync")
    try:
        checked_schema = json.loads(SCHEMA_ARTIFACT.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        errors.append(f"shared/skills/media/MCP_SCHEMA.json is invalid: {error}")
    else:
        if checked_schema != schema:
            errors.append("MCP schema artifact differs from the release bundle; run with --sync")
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print(f"media capabilities OK: {len(names)} dynamically discovered tools")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
