#!/bin/sh

set -eu

BASE_DIR="${BASE_DIR:-/conf/pritunl-native}"
STATE_DIR="${STATE_DIR:-$BASE_DIR/state}"
RUN_DIR="${RUN_DIR:-/var/run/pritunl-native}"
LOG_DIR="${LOG_DIR:-/var/log/pritunl-native}"
PID_FILE="$RUN_DIR/watcher.pid"
OPENVPN_PID_FILE="/var/run/ovpn-instance-6387ef44-4e9a-4c79-af35-c829c2eb0766.pid"
OPENVPN_CONFIG="/var/etc/openvpn/instance-6387ef44-4e9a-4c79-af35-c829c2eb0766.conf"
WATCHER="/usr/local/opnsense/scripts/pritunl-native/watcher.sh"
START_LOCK_FILE="$RUN_DIR/start.lock"
WATCHER_LOCK_FILE="$RUN_DIR/watcher.lock"

find_watcher_pid() {
    if [ -r "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE")"
        case "$pid" in
            ''|*[!0-9]*) ;;
            *) if kill -0 "$pid" 2>/dev/null; then printf '%s\n' "$pid"; return; fi ;;
        esac
    fi
    /usr/bin/pgrep -f "^/bin/sh ${WATCHER}$" 2>/dev/null | sed -n '1p'
}

find_watcher_daemon_pid() {
    /usr/bin/pgrep -f "^daemon: ${WATCHER}" 2>/dev/null | sed -n '1p'
}

find_openvpn_pid() {
    if [ -r "$OPENVPN_PID_FILE" ]; then
        pid="$(cat "$OPENVPN_PID_FILE")"
        case "$pid" in
            ''|*[!0-9]*) ;;
            *) if kill -0 "$pid" 2>/dev/null; then printf '%s\n' "$pid"; return; fi ;;
        esac
    fi
    /usr/bin/pgrep -f "^/usr/local/sbin/openvpn --config ${OPENVPN_CONFIG}" 2>/dev/null | sed -n '1p'
}

status() {
    watcher_pid="$(find_watcher_pid || true)"
    if [ -n "$watcher_pid" ]; then
        printf 'running pid=%s\n' "$watcher_pid"
    elif [ -e "$STATE_DIR/lockout" ]; then
        printf 'locked out\n'
    else
        printf 'stopped\n'
    fi
    openvpn_pid="$(find_openvpn_pid || true)"
    if [ -n "$openvpn_pid" ]; then
        printf 'openvpn_pid=%s\n' "$openvpn_pid"
    fi
    now="$(date +%s)"
    cutoff=$((now - 86400))
    if [ -r "$STATE_DIR/attempt-history" ]; then
        attempts="$(awk -v cutoff="$cutoff" '$1 ~ /^[0-9]+$/ && $1 > cutoff { count++ } END { print count + 0 }' "$STATE_DIR/attempt-history")"
    else
        attempts="$(cat "$STATE_DIR/failures-since-reset" 2>/dev/null || printf 0)"
    fi
    printf 'attempts_last_24h=%s\n' "$attempts"
    printf 'consecutive_failures=%s\n' "$(cat "$STATE_DIR/consecutive-failures" 2>/dev/null || printf 0)"
}

start_locked() {
        mkdir -p "$RUN_DIR" "$LOG_DIR"
        if [ -e "$STATE_DIR/lockout" ]; then
            printf 'Locked out. Run vpnctl reset first.\n' >&2
            exit 78
        fi
        watcher_pid="$(find_watcher_pid || true)"
        if [ -n "$watcher_pid" ]; then
            printf 'Already running.\n'
            exit 0
        fi
        watcher_daemon_pid="$(find_watcher_daemon_pid || true)"
        if [ -n "$watcher_daemon_pid" ]; then
            printf 'Refusing to start while watcher daemon pid %s is still running.\n' "$watcher_daemon_pid" >&2
            exit 70
        fi
        openvpn_pid="$(find_openvpn_pid || true)"
        if [ -n "$openvpn_pid" ]; then
            printf 'Refusing to start while OpenVPN pid %s is still running.\n' "$openvpn_pid" >&2
            exit 70
        fi
        /usr/sbin/daemon -f -p "$PID_FILE" /usr/bin/lockf -t 0 "$WATCHER_LOCK_FILE" "$WATCHER"
        sleep 1
        status
}

case "${1:-status}" in
    start)
        mkdir -p "$RUN_DIR"
        chmod 0700 "$RUN_DIR"
        exec /usr/bin/lockf -t 10 "$START_LOCK_FILE" "$0" _start_locked
        ;;
    _start_locked)
        start_locked
        ;;
    stop)
        watcher_pid="$(find_watcher_pid || true)"
        if [ -n "$watcher_pid" ]; then
            pid="$watcher_pid"
            kill -TERM "$pid" 2>/dev/null || true
            wait_count=0
            while kill -0 "$pid" 2>/dev/null && [ "$wait_count" -lt 10 ]; do
                sleep 1
                wait_count=$((wait_count + 1))
            done
            if kill -0 "$pid" 2>/dev/null; then
                kill -KILL "$pid" 2>/dev/null || true
            fi
        fi
        rm -f "$PID_FILE"
        watcher_daemon_pid="$(find_watcher_daemon_pid || true)"
        if [ -n "$watcher_daemon_pid" ]; then
            kill -TERM "$watcher_daemon_pid" 2>/dev/null || true
            sleep 1
            if kill -0 "$watcher_daemon_pid" 2>/dev/null; then
                kill -KILL "$watcher_daemon_pid" 2>/dev/null || true
            fi
        fi
        openvpn_pid="$(find_openvpn_pid || true)"
        if [ -n "$openvpn_pid" ]; then
            kill -TERM "$openvpn_pid" 2>/dev/null || true
            wait_count=0
            while kill -0 "$openvpn_pid" 2>/dev/null && [ "$wait_count" -lt 10 ]; do
                sleep 1
                wait_count=$((wait_count + 1))
            done
            if kill -0 "$openvpn_pid" 2>/dev/null; then
                kill -KILL "$openvpn_pid" 2>/dev/null || true
            fi
        fi
        rm -f "$OPENVPN_PID_FILE"
        printf 'Stopped.\n'
        ;;
    reset)
        if [ -n "$(find_watcher_pid || true)" ] || [ -n "$(find_openvpn_pid || true)" ]; then
            printf 'Stop both the watcher and OpenVPN before reset.\n' >&2
            exit 69
        fi
        rm -f "$STATE_DIR/lockout" "$STATE_DIR/consecutive-failures" "$STATE_DIR/last-attempt"
        printf 'Fail-safe lockout reset. Rolling 24-hour attempt history preserved.\n'
        ;;
    reset-attempts)
        if [ -n "$(find_watcher_pid || true)" ] || [ -n "$(find_openvpn_pid || true)" ]; then
            printf 'Stop both the watcher and OpenVPN before resetting attempts.\n' >&2
            exit 69
        fi
        rm -f "$STATE_DIR/lockout" "$STATE_DIR/attempts-since-reset" "$STATE_DIR/attempt-history" "$STATE_DIR/failures-since-reset" "$STATE_DIR/consecutive-failures" "$STATE_DIR/last-attempt"
        printf 'Manual override: lockout and all retry attempt history reset.\n'
        ;;
    status)
        status
        ;;
    logs)
        tail -n 100 "$LOG_DIR/watcher.log" "$LOG_DIR/events.log" 2>/dev/null || true
        ;;
    refresh-routes)
        /usr/local/opnsense/scripts/pritunl-native/route-table.sh refresh
        ;;
    test-retry-contract)
        test_root="$(mktemp -d /tmp/pritunl-native-test.XXXXXX)"
        trap 'rm -rf "$test_root"' EXIT INT TERM
        mkdir -p "$test_root/secrets" "$test_root/state" "$test_root/run" "$test_root/logs"
        printf 'test\n' > "$test_root/secrets/username"
        printf 'test\n' > "$test_root/secrets/pin"
        printf 'JBSWY3DPEHPK3PXP\n' > "$test_root/secrets/totp-seed"
        chmod 0600 "$test_root/secrets/"*
        set +e
        BASE_DIR="$test_root" SECRET_DIR="$test_root/secrets" STATE_DIR="$test_root/state" \
            RUN_DIR="$test_root/run" LOG_DIR="$test_root/logs" SIMULATE_AUTH_FAILURE=true \
            OPENVPN_PID_FILE="$test_root/openvpn.pid" MIN_RETRY_INTERVAL_SECONDS=1 \
            STABLE_SESSION_SECONDS=1 MAX_ATTEMPTS=3 "$WATCHER" >/dev/null 2>&1
        rc=$?
        set -e
        attempts_state="$(wc -l < "$test_root/state/attempt-history" | tr -d ' ')"
        lockouts="$(grep -c 'lockout rolling=3 consecutive=3' "$test_root/logs/events.log" || true)"
        attempts="$(grep -c 'attempt-start' "$test_root/logs/events.log" || true)"
        if [ "$rc" -eq 78 ] && [ "$attempts_state" -eq 3 ] && [ "$lockouts" -eq 1 ] && [ "$attempts" -eq 3 ]; then
            printf 'PASS attempts=3 reserved=3 lockouts=1 exit=78\n'
        else
            printf 'FAIL attempts=%s reserved=%s lockouts=%s exit=%s\n' "$attempts" "$attempts_state" "$lockouts" "$rc" >&2
            exit 1
        fi
        ;;
    *)
        printf 'Usage: vpnctl {start|stop|reset|reset-attempts|status|logs|refresh-routes|test-retry-contract}\n' >&2
        exit 64
        ;;
esac
