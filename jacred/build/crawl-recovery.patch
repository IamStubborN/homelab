diff --git a/tests/JacRed.Tests/Networking/CrawlSolverAdmissionTests.cs b/tests/JacRed.Tests/Networking/CrawlSolverAdmissionTests.cs
new file mode 100644
index 0000000..23cb78d
--- /dev/null
+++ b/tests/JacRed.Tests/Networking/CrawlSolverAdmissionTests.cs
@@ -0,0 +1,187 @@
+using JacRed.Infrastructure.Networking;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace JacRed.Tests.Networking;
+
+public class CrawlSolverAdmissionTests
+{
+    [Fact]
+    public async Task DifferentHosts_CannotOverlapBrowserOperations()
+    {
+        var firstStarted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var releaseFirst = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var secondStarted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var first = CloudflareClearance.CallSolverAsync("http://solver.test/v1", new() { ["url"] = "https://kinozal.test/" }, 1000, true, async () =>
+        {
+            firstStarted.SetResult();
+            await releaseFirst.Task;
+            return JObject.Parse("{\"status\":\"ok\"}");
+        });
+        await firstStarted.Task.WaitAsync(TimeSpan.FromSeconds(3));
+        var second = CloudflareClearance.CallSolverAsync("http://solver.test/v1", new() { ["url"] = "https://anibelka.test/" }, 1000, true, () =>
+        {
+            secondStarted.SetResult();
+            return Task.FromResult(JObject.Parse("{\"status\":\"ok\"}"));
+        });
+        try { Assert.False(secondStarted.Task.IsCompleted); }
+        finally
+        {
+            releaseFirst.TrySetResult();
+            await Task.WhenAll(first, second);
+        }
+    }
+}
+
