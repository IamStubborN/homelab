#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
: "${MEDIA_RELEASE_DIR:?MEDIA_RELEASE_DIR is required}"
checker=${HERMES_CAPABILITY_CHECKER:-"$root/scripts/check-media-capabilities"}

live_tools=
live_attestation=
while test "$#" -gt 0; do
    case $1 in
        --live-tools)
            test "$#" -ge 2 || { echo "usage: $0 [--live-tools FILE] [--live-attestation FILE]" >&2; exit 2; }
            live_tools=$2
            shift 2
            ;;
        --live-attestation)
            test "$#" -ge 2 || { echo "usage: $0 [--live-tools FILE] [--live-attestation FILE]" >&2; exit 2; }
            live_attestation=$2
            shift 2
            ;;
        *)
            echo "usage: $0 [--live-tools FILE] [--live-attestation FILE]" >&2
            exit 2
            ;;
    esac
done

python3 "$checker" --release-dir "$MEDIA_RELEASE_DIR"

if test -n "$live_tools"; then
    python3 - "$root/scripts" "$MEDIA_RELEASE_DIR" "$live_tools" <<'PY'
import json
import pathlib
import sys

sys.path.insert(0, sys.argv[1])
from media_release_contract import load_release_contract

release_dir = pathlib.Path(sys.argv[2])
load_release_contract(release_dir)
expected = json.loads((release_dir / "MCP_SCHEMA.json").read_text(encoding="utf-8"))["tools"]
actual = json.loads(pathlib.Path(sys.argv[3]).read_text(encoding="utf-8"))
canonical = lambda tools: json.dumps(
    sorted(tools, key=lambda tool: tool["name"]),
    ensure_ascii=False,
    sort_keys=True,
    separators=(",", ":"),
)
if canonical(expected) != canonical(actual):
    raise SystemExit("live media MCP tools/list differs from the release bundle")
PY
fi

if test -n "$live_attestation"; then
    python3 - "$root/scripts" "$MEDIA_RELEASE_DIR" "$live_attestation" <<'PY'
import json
import pathlib
import sys

sys.path.insert(0, sys.argv[1])
from media_release_contract import load_release_contract

release = load_release_contract(pathlib.Path(sys.argv[2]))
raw = json.loads(pathlib.Path(sys.argv[3]).read_text(encoding="utf-8"))
if isinstance(raw, list):
    if len(raw) != 1 or not isinstance(raw[0], dict):
        raise SystemExit("live media OCI attestation is invalid")
    config = raw[0].get("Config")
    if not isinstance(config, dict) or not isinstance(config.get("Labels"), dict):
        raise SystemExit("live media OCI attestation is invalid")
    labels = config["Labels"]
    actual = {
        "image": config.get("Image"),
        "revision": labels.get("org.opencontainers.image.revision"),
        "version": labels.get("org.opencontainers.image.version"),
        "source_tree_digest": labels.get("dev.iamstubborn.media.source-tree-digest"),
        "runner_build_digest": labels.get("dev.iamstubborn.media.runner-build-digest"),
    }
elif isinstance(raw, dict):
    actual = raw
else:
    raise SystemExit("live media OCI attestation is invalid")
expected = {
    "image": release["service_image"],
    "revision": release["source_revision"],
    "version": release["application_version"],
    "source_tree_digest": release["source_tree_digest"],
    "runner_build_digest": release["runner_build_digest"],
}
if actual != expected:
    raise SystemExit("live media OCI attestation differs from the release bundle")
PY
fi
