[Unit]
Description=Daily application data backup to Google Drive
Wants=network-online.target
After=network-online.target pve-guests.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homelab-backup-to-google-drive apps
ExecStopPost=-/usr/local/libexec/homelab-backup-monitor record daily-apps
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=12h
