#!/bin/sh
# One-time root setup of the guarded Hermes auto-update, then one supervised
# run. Usage on the Docker host:
#   sudo sh hermes/scripts/install-auto-update              # install and run once
#   sudo sh hermes/scripts/install-auto-update --enable-timer  # also enable 02:30
set -eu

here=$(cd "$(dirname "$0")/.." && pwd)
unit=hermes-auto-update

if [ "$(id -u)" -ne 0 ]; then
    echo "Run as root: sudo sh $0 $*" >&2
    exit 1
fi
enable_timer=false
case "${1:-}" in
    --enable-timer) enable_timer=true ;;
    "") ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
esac

echo "1/4 Installing $unit.service and $unit.timer into /etc/systemd/system"
install -m 0644 "$here/$unit.service" "$here/$unit.timer" /etc/systemd/system/
systemctl daemon-reload

echo "2/4 Dry run: is an update due, are both agents idle (changes nothing)"
DRY_RUN=1 python3 "$here/scripts/hermes-auto-update" || {
    echo "Dry run reported a problem; nothing was changed." >&2
    exit 1
}

echo "3/4 Supervised run through systemd (canaries, wait for idle agents, snapshot, apply);"
echo "    a failure rolls back by itself. This can take up to an hour."
systemctl start "$unit.service" || true
journalctl -u "$unit.service" --since "-2h" --no-pager -o cat | tail -n 30
result=$(systemctl show -p Result --value "$unit.service")
docker inspect -f '{{.Name}} {{.State.Health.Status}} {{.Config.Image}}' hermes-primary hermes-secondary

if [ "$result" != success ]; then
    echo "4/4 Skipped: the run ended with '$result'; the timer stays off." >&2
    exit 1
fi
if $enable_timer; then
    echo "4/4 Enabling the nightly timer (02:30 Europe/Sofia)"
    systemctl enable --now "$unit.timer"
    systemctl list-timers "$unit.timer" --no-pager
else
    echo "4/4 Timer left off; enable it with: sudo systemctl enable --now $unit.timer"
fi
