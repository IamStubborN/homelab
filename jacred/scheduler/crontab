# JacRed scheduler: container timezone is Europe/Sofia (TIMEZONE in Compose).
# Incremental updates run every 4–6 hours; heavy jobs start at night.
# ParseAll is asynchronous and can continue outside these start times.
# The built-in startup worker also resumes pending cycles after 45 seconds.
# Keep checkpoints; there is no supported pause/cancel window in v3.15.1.
# No tracker starts at 22:00–23:59; speed tests start at 23:00 / 23:30.
# Install through the root Compose project; this file is baked into jacred-cron.
# run-job.sh locks protect HTTP requests, not background ParseAll lifetime.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Persistence and bounded log retention remain frequent.
*/5 * * * * /usr/local/bin/run-job.sh jsondb-save http://jacred:9117/jsondb/save 60
*/15 * * * * /usr/local/bin/rotate-jacred-logs.sh

45 3 * * 0 /usr/local/bin/run-job.sh maintenance-check http://jacred:9117/cron/maintenance/Check?mode=report 60
# Resume incomplete checkpoints once nightly; do not add a daytime resume loop.
10 0 * * * /usr/local/bin/run-job.sh parseall-resume http://jacred:9117/cron/maintenance/ResumeParseAll 60
# Tracker refreshes: cheap recent-page fetches keep daytime search reasonably fresh.
20 0 * * * /usr/local/bin/run-job.sh rutracker-parse http://jacred:9117/cron/rutracker/parse 3600
35 1 * * 3 /usr/local/bin/run-job.sh rutracker-UpdateTasksParse http://jacred:9117/cron/rutracker/UpdateTasksParse 60
