#!/bin/sh
set -eu

unset HEALTH_API_TOKEN

read_secret() {
    variable=$1
    path=$2
    if [ ! -s "$path" ]; then
        echo "Required secret is missing: $path" >&2
        exit 1
    fi
    value=$(cat "$path")
    export "$variable=$value"
}

read_secret TELEGRAM_BOT_TOKEN /run/secrets/telegram_bot_token
read_secret API_SERVER_KEY /run/secrets/webhook_hmac
read_secret MEDIA_API_TOKEN /run/secrets/media_api_token
read_secret HOMEASSISTANT_API_TOKEN /run/secrets/homeassistant_api_token
read_secret OPENAI_API_KEY /run/secrets/omniroute_api_key
export OPENAI_BASE_URL=http://omniroute:20129/v1
read_secret GROQ_API_KEY /run/secrets/groq_api_key

python_packages=/opt/data/python-packages
if [ ! -d "$python_packages/youtube_transcript_api" ]; then
    UV_CACHE_DIR=/tmp/uv-cache uv pip install --target "$python_packages" youtube-transcript-api==1.2.4
    chown -R 10000:10000 "$python_packages"
fi
if [ ! -d "$python_packages/ddgs" ]; then
    UV_CACHE_DIR=/tmp/uv-cache uv pip install --target "$python_packages" ddgs
    chown -R 10000:10000 "$python_packages"
fi
export PYTHONPATH="$python_packages${PYTHONPATH:+:$PYTHONPATH}"

# Durable temp for TTS/auto-TTS (Hermes blocks /tmp as protected)
install -d -o 10000 -g 10000 -m 1777 /opt/data/tmp
export TMPDIR=/opt/data/tmp
export TMP=/opt/data/tmp
export TEMP=/opt/data/tmp

runtime_secret_dir=/run/hermes-home-secrets
install -d -o 10000 -g 10000 -m 0700 "$runtime_secret_dir"
for secret in media_api_token health_api_token broker_api_token webhook_hmac search_ladder_api_key; do
    source="/run/secrets/$secret"
    [ -f "$source" ] || continue
    install -o 10000 -g 10000 -m 0400 "$source" "$runtime_secret_dir/$secret"
done

materialize_hermes_config() {
    python=$1
    merger=$2
    managed=$3
    persistent_base=$4
    active_link=$5
    runtime_config=$6
    health_secret=$7
    temporary_directory=${8:-/tmp}
    current=$persistent_base
    if [ ! -f "$current" ] && [ -f "$active_link" ] && [ ! -L "$active_link" ]; then
        current=$active_link
    fi
    generated_base=$(mktemp "$temporary_directory/hermes-base.XXXXXX")
    generated_config=$(mktemp "$temporary_directory/hermes-config.XXXXXX")
    trap 'rm -f "$generated_base" "$generated_config" "$runtime_config" || :' EXIT
    trap 'exit 1' HUP INT TERM
    "$python" "$merger" \
        "$managed" "$current" "$generated_base" --sanitize-health
    install -o 10000 -g 10000 -m 0640 "$generated_base" "$persistent_base"
    # The sanitized base now contains every preserved setting. Remove a legacy
    # regular active config before secret validation or runtime installation can
    # fail, so an old health bearer cannot survive in the named volume.
    rm -f "$active_link"
    "$python" "$merger" \
        "$managed" "$persistent_base" "$generated_config" "$health_secret"
    install -o 10000 -g 10000 -m 0600 "$generated_config" "$runtime_config"
    ln -s "$runtime_config" "$active_link"
    rm -f "$generated_base" "$generated_config"
    trap - EXIT HUP INT TERM
}

materialize_hermes_config \
    /opt/hermes/.venv/bin/python \
    /usr/local/bin/merge-hermes-config \
    /etc/hermes-home/config.yaml \
    /opt/data/config.base.yaml \
    /opt/data/config.yaml \
    /run/hermes-config.yaml \
    "$runtime_secret_dir/health_api_token" \
    /tmp
install -o 10000 -g 10000 -m 0644 /etc/hermes-home/SOUL.md /opt/data/SOUL.md

install_skills() {
    source=$1
    install_catalog=$2
    cleanup_catalog=$3
    destination_root=${4:-/opt/data/skills}
    current=
    for name in $install_catalog; do
        skill="$source/$name"
        [ -d "$skill" ] || continue
        current="$current $name"
        destination="$destination_root/$name"
        mkdir -p "$destination"
        cp -R "$skill"/. "$destination"/
    done
    for skill in "$destination_root"/*; do
        [ -d "$skill" ] || continue
        name=$(basename "$skill")
        case " $cleanup_catalog " in
            *" $name "*) case " $current " in *" $name "*) ;; *) rm -rf "$skill" ;; esac ;;
        esac
    done
}

shared_skills="health home-assistant media search-ladder"
shared_skill_cleanup="$shared_skills media-admin movies series trending watching"
install_skills /etc/hermes-home/skills "$shared_skills" "$shared_skill_cleanup"
install_skills /etc/hermes-home/personal-skills "vaultwarden-login" "vaultwarden-login"
chown -R 10000:10000 /opt/data/skills

# Shared skills are managed by this repository, not by background reviews.
for skill in /etc/hermes-home/skills/*; do
    [ -d "$skill" ] || continue
    /command/s6-setuidgid hermes /opt/hermes/.venv/bin/hermes \
        curator pin "$(basename "$skill")" >/dev/null 2>&1 || true
done

install_plugins() {
    source=$1
    mkdir -p /opt/data/plugins
    for plugin in "$source"/*; do
        [ -d "$plugin" ] || continue
        destination="/opt/data/plugins/$(basename "$plugin")"
        mkdir -p "$destination"
        cp -R "$plugin"/. "$destination"/
    done
}

install_plugins /etc/hermes-home/personal-plugins
install_plugins /etc/hermes-home/shared-plugins
chown -R 10000:10000 /opt/data/plugins
# Keep the derived schema cache across ordinary restarts. The checked-in schema
# artifact is available during offline startup; its canonical tool array changes
# exactly when the deployed media MCP contract changes.
schema_artifact=/etc/hermes-home/skills/media/MCP_SCHEMA.json
schema_revision_cache=/opt/data/cache/media_mcp_schema_revision
install -d -o 10000 -g 10000 -m 0755 /opt/data/cache
if [ ! -s "$schema_artifact" ]; then
    echo "Required media MCP schema artifact is missing: $schema_artifact" >&2
    exit 1
fi
schema_revision=$(
    /opt/hermes/.venv/bin/python /usr/local/bin/hermes-mcp-schema-revision \
        "$schema_artifact"
)
if [ ! -s "$schema_revision_cache" ] || \
   [ "$(cat "$schema_revision_cache")" != "$schema_revision" ]; then
    rm -f \
        /opt/data/cache/mcp_schema_cache.json \
        /opt/data/cache/tool_discovery_cache.json
    printf '%s\n' "$schema_revision" >/tmp/media-mcp-schema-revision
    install -o 10000 -g 10000 -m 0644 \
        /tmp/media-mcp-schema-revision "$schema_revision_cache"
    rm -f /tmp/media-mcp-schema-revision
fi
if [ -d /opt/data/plugins/vaultwarden-approval ]; then
    /command/s6-setuidgid hermes /opt/hermes/.venv/bin/hermes plugins enable vaultwarden-approval >/dev/null
fi

exec /init /opt/hermes/docker/main-wrapper.sh "$@"
