+public class CrawlSolverHttpTests
+{
+    static async Task WithResponse(int status, string body, Func<string, Task> test)
+    {
+        var portProbe = new System.Net.Sockets.TcpListener(System.Net.IPAddress.Loopback, 0);
+        portProbe.Start();
+        int port = ((System.Net.IPEndPoint)portProbe.LocalEndpoint).Port;
+        portProbe.Stop();
+        using var server = new System.Net.HttpListener();
+        string endpoint = $"http://127.0.0.1:{port}/";
+        server.Prefixes.Add(endpoint);
+        server.Start();
+        var serve = Task.Run(async () =>
+        {
+            var context = await server.GetContextAsync();
+            context.Response.StatusCode = status;
+            context.Response.ContentType = "application/json";
+            var bytes = System.Text.Encoding.UTF8.GetBytes(body);
+            context.Response.ContentLength64 = bytes.Length;
+            await context.Response.OutputStream.WriteAsync(bytes);
+            context.Response.Close();
+        });
+        try { await test(endpoint); await serve.WaitAsync(TimeSpan.FromSeconds(5)); }
+        finally { server.Stop(); }
+    }
+
+    [Fact]
+    public async Task RealHttp500MissingSessionRemainsRecoverable()
+    {
+        await WithResponse(500, "{\"status\":\"error\",\"message\":\"The session doesn't exist.\"}", async endpoint =>
+        {
+            var result = await CloudflareClearance.CallSolverAsync(endpoint,
+                new() { ["cmd"] = "sessions.destroy" }, 2000, true, admission: new());
+            Assert.Equal("The session doesn't exist.", result.Value<string>("message"));
+        });
+    }
+
+    [Theory]
+    [InlineData(503, "{\"status\":\"error\",\"message\":\"Browser pool busy\"}")]
+    [InlineData(500, "{\"status\":\"error\",\"message\":\"Cannot fork\"}")]
+    [InlineData(200, "{\"status\":\"ok\"}")]
+    [InlineData(200, "{\"status\":\"ok\",\"solution\":{\"status\":200}}")]
+    [InlineData(200, "{\"status\":\"ok\",\"solution\":{\"status\":\"oops\",\"response\":\"html\"}}")]
+    public async Task RealHttpDependencyFailureCannotConsumePageBudget(int status, string body)
+    {
+        await WithResponse(status, body, endpoint => Assert.ThrowsAsync<SolverDependencyUnavailableException>(() =>
+            CloudflareClearance.CallSolverAsync(endpoint, new() { ["cmd"] = "request.get" }, 2000,
+                true, admission: new())));
+    }
+
+    [Fact]
+    public async Task RealOrigin404RemainsPageFailure()
+    {
+        await WithResponse(200, "{\"status\":\"ok\",\"solution\":{\"status\":404,\"response\":\"not found\"}}", async endpoint =>
+        {
+            var result = await CloudflareClearance.CallSolverAsync(endpoint, new() { ["cmd"] = "request.get" },
+                2000, true, admission: new());
+            Assert.Equal(404, result["solution"].Value<int>("status"));
+        });
+    }
+}
