# 3,18,33,48 * * * *  /usr/local/bin/run-job.sh kinozal-parse http://jacred:9117/cron/kinozal/parse 900

# kinozal-UpdateTasksParse -> /cron/kinozal/UpdateTasksParse (max_time=60s)
10 2 * * *  /usr/local/bin/run-job.sh kinozal-UpdateTasksParse http://jacred:9117/cron/kinozal/UpdateTasksParse 60

# kinozal-ParseAllTask -> /cron/kinozal/ParseAllTask (max_time=60s)
# One daily kick; ResumeParseAll continues an existing cycle.
# Temporarily disabled to avoid starting another full browser-heavy cycle.
# 35 5 * * *  /usr/local/bin/run-job.sh kinozal-ParseAllTask http://jacred:9117/cron/kinozal/ParseAllTask 60

