# JacRed host crontab — edit by hand (source of truth).
# Install: crontab /opt/jacred/Data/crontab
# Runner:  /usr/local/bin/run-job.sh <name> <url> <max_time>
#   flock (no curl pile-up) + curl --max-time
# Default base: http://jacred:9117 — change host/port if needed.
# If apikey/devkey is set, append ?apikey=... or ?devkey=... to each URL.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# jsondb-save -> /jsondb/save (max_time=60s)
# every 5 min (e.g. :00,:05,:10,…)
*/5 * * * *  /usr/local/bin/run-job.sh jsondb-save http://jacred:9117/jsondb/save 60

# tracks.log is written directly by JacRed and has no application-side limit.
# Keep five 50 MiB generations without restarting JacRed.
*/15 * * * *  /usr/local/bin/rotate-jacred-logs.sh

# cloudflare-warmup keep-alive -> /cron/cloudflare/Warmup (max_time=300s)
# Temporarily disabled during ParseAll recovery to free browser processes.
# 5,25,45 * * * *  /usr/local/bin/run-job.sh cloudflare-keepalive http://jacred:9117/cron/cloudflare/Warmup 300

# cloudflare-warmup -> /cron/cloudflare/Warmup (max_time=300s)
# Temporarily disabled during ParseAll recovery to free browser processes.
# 55 * * * *  /usr/local/bin/run-job.sh cloudflare-warmup http://jacred:9117/cron/cloudflare/Warmup 300

# maintenance-check -> /cron/maintenance/Check?mode=report (max_time=60s)
# Sunday 05:00
0 5 * * 0  /usr/local/bin/run-job.sh maintenance-check http://jacred:9117/cron/maintenance/Check?mode=report 60

# parseall-resume -> /cron/maintenance/ResumeParseAll (max_time=60s)
# continue incomplete cycles after restart / hung cancel; idle if pending=0
*/15 * * * *  /usr/local/bin/run-job.sh parseall-resume http://jacred:9117/cron/maintenance/ResumeParseAll 60

# --- rutracker (~1.5M) ---
# rutracker-parse -> /cron/rutracker/parse (max_time=3600s)
# Once daily while the initial ParseAll cycle is running; restore the regular
# incremental cadence after that cycle completes.
0 1 * * *  /usr/local/bin/run-job.sh rutracker-parse http://jacred:9117/cron/rutracker/parse 3600

# rutracker-UpdateTasksParse -> /cron/rutracker/UpdateTasksParse (max_time=60s)
20 3 * * *  /usr/local/bin/run-job.sh rutracker-UpdateTasksParse http://jacred:9117/cron/rutracker/UpdateTasksParse 60

# rutracker-ParseAllTask -> /cron/rutracker/ParseAllTask (max_time=60s)
# Initial cycle is already running. ResumeParseAll covers restarts; leave the
# daily kick disabled so completion does not start another full scan.
# 40 4 * * *  /usr/local/bin/run-job.sh rutracker-ParseAllTask http://jacred:9117/cron/rutracker/ParseAllTask 60

# --- kinozal (~550k) ---
# kinozal-parse -> /cron/kinozal/parse (max_time=900s)
