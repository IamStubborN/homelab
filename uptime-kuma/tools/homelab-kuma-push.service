[Unit]
Description=Publish selected container health to Uptime Kuma
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/homelab-kuma-push /etc/homelab/uptime-kuma-push.json
TimeoutStartSec=50
StateDirectory=homelab-kuma
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
