[Unit]
Description=PBS local garbage collection and cloud pack maintenance
After=network-online.target pve-guests.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homelab-pbs-maintenance
ExecStopPost=-/usr/local/libexec/homelab-backup-monitor record pbs-maintenance
Nice=10
AllowedCPUs=0-2
CPUQuota=150%
IOWeight=50
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
SuccessExitStatus=75
